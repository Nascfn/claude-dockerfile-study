# Version control and editor files
.git
.gitignore
.vscode
.idea

# Local secrets and environment files. Pass runtime config with
# `docker run --env-file` or `-e` instead of baking it into the image.
.env
.env.*

# Installed and built output. These are produced inside the image.
node_modules
**/node_modules
frontend/build

# Docker files themselves
Dockerfile
.dockerignore

# Logs, coverage, and diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage
.nyc_output
.cache
.eslintcache

# Docs and media that the server does not need at runtime
**/*.md
assets
